# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=industrial_rag
DATABASE_URL=postgresql://rag:change-me-in-production@db:5432/industrial_rag

# Answer engine. One key is enough. Without any key, the app still runs and shows
# the source passages without rewriting them.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# auto = Gemini, then Claude, then extracts. Other values: gemini, anthropic, extractive
LLM_PROVIDER=auto

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-haiku-5-5
# RETRIEVAL_MIN_SCORE=0.30

# Required for a public deployment
# ADMIN_TOKEN=a-long-random-string
# ALLOWED_ORIGINS=https://your-domain.example
# NEXT_PUBLIC_API_URL=https://api.your-domain.example
